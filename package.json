{
    "name": "fu-clan-management-system",
    "version": "0.1.0",
    "private": true,
    "main": "dist-electron/main.js",
    "homepage": "./",
    "dependencies": {
        "@ant-design/icons": "^6.3.4",
        "@reduxjs/toolkit": "^2.13.0",
        "antd": "^6.6.6",
        "axios": "^1.20.0",
        "dayjs": "^1.11.23",
        "lodash": "^4.18.1",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-redux": "^9.3.0",
        "react-router-dom": "^7.18.4",
        "redux": "^5.0.1",
        "sql.js": "^1.14.2",
        "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
    },
    "scripts": {
        "start": "vite",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "test": "vitest",
        "build:electron": "tsc -p tsconfig.electron.json",
        "electron": "npm run build:electron && electron .",
        "electron:dev": "concurrently -k \"vite\" \"npm run build:electron && wait-on tcp:127.0.0.1:3000 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:3000 electron .\"",
        "electron:build": "npm run build && npm run build:electron && electron-builder --config electron-builder.js"
    },
    "devDependencies": {
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/lodash": "^4.17.26",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/sql.js": "^1.4.11",
        "@vitejs/plugin-react": "^6.1.2",
        "concurrently": "^10.0.6",
        "cross-env": "^10.1.0",
        "electron": "^44.7.2",
        "electron-builder": "^26.15.3",
        "jsdom": "^29.1.1",
        "typescript": "^5.9.3",
        "vite": "^8.3.4",
        "vitest": "^5.0.4",
        "wait-on": "^9.5.1"
    },
    "overrides": {
        "global-agent": "^4.1.3"
    }
}
